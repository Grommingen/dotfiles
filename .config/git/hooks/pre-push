#!/usr/bin/env bash
# Global pre-push (core.hooksPath). In repositories with `git config review.auto true`,
# start review-bot in the background for each pushed branch's new commits. The push is
# never delayed or blocked by it. Then run the repository's own pre-push hook.
set -u
updates=$(cat)    # "<local ref> <local sha> <remote ref> <remote sha>" per line
zero=0000000000000000000000000000000000000000

if [ "$(git config --bool review.auto)" = true ]; then
  root=$(git rev-parse --show-toplevel)
  bot="${REVIEW_BOT_BIN:-$HOME/.claude/bin/review-bot}"
  while read -r _lref lsha _rref rsha; do
    [ -n "${lsha:-}" ] && [ "$lsha" != "$zero" ] || continue          # a branch deletion
    if [ "$rsha" != "$zero" ]; then
      base=$(git merge-base "$lsha" "$rsha" 2>/dev/null) || continue  # remote commit unknown
    else                                                               # a new branch
      base=$(git merge-base "$lsha" refs/remotes/origin/HEAD 2>/dev/null) || continue
    fi
    [ "$base" != "$lsha" ] || continue                                 # nothing new
    nohup "$bot" "$root" "$base" "$lsha" </dev/null >/dev/null 2>&1 &
  done <<<"$updates"
fi

printf '%s\n' "$updates" | CHAIN_HOOK=pre-push "$(dirname "$0")/_chain" "$@"
