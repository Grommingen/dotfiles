#!/usr/bin/env bash
# Claude Code Stop hook. When the session's repository has a review-relay request,
# start review-bot for it in the background. review-bot decides whether the request
# is pending and takes the lock, so this hook stays fast. It never blocks or fails
# the session.
[ -n "${REVIEW_BOT:-}" ] && exit 0          # the reviewer's own session
payload=$(cat)
cwd=$(jq -r '.cwd // empty' <<<"$payload" 2>/dev/null)
root=$(git -C "${CLAUDE_PROJECT_DIR:-${cwd:-.}}" rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$root/.review-relay/request.yaml" ] || exit 0
bot="${REVIEW_BOT_BIN:-$HOME/.claude/bin/review-bot}"
[ -x "$bot" ] || exit 0
nohup "$bot" "$root" </dev/null >/dev/null 2>&1 &
exit 0
