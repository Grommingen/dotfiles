#!/usr/bin/env bash
# review-bot ROOT BASE HEAD
#
# Reviews the commits BASE..HEAD of ROOT with Claude Code's built-in /code-review, in a
# separate worktree, so ROOT's working tree is never touched. Started by the global
# pre-push hook in repositories with `git config review.auto true`.
#   1. takes a lock, so the same HEAD is reviewed once
#   2. creates a worktree whose HEAD is BASE and whose index and files are HEAD, so the
#      change under review is the worktree's uncommitted diff
#   3. runs `claude -p "/code-review <level> --fix"` there, with an allowlist of tools and
#      a budget cap, and saves the report
#   4. if the reviewer changed files, commits them on branch review/<short HEAD> on top of
#      HEAD for you to merge; then removes the worktree and sends a macOS notification
#
# Settings (environment):
#   REVIEW_BOT_MODEL   model for the reviewer (default sonnet)
#   REVIEW_BOT_BUDGET  max USD per review (default 2)
#   REVIEW_BOT_LEVEL   /code-review level: low|medium|high|xhigh (default medium)
# Per repository: `git config review.testCommand "make test"` lets the reviewer run tests.
# State: ${XDG_STATE_HOME:-~/.local/state}/review-bot/{reports,logs}/
set -euo pipefail

root=$(git -C "${1:?usage: review-bot ROOT BASE HEAD}" rev-parse --show-toplevel)
base=$(git -C "$root" rev-parse --verify "${2:?BASE}^{commit}")
head=$(git -C "$root" rev-parse --verify "${3:?HEAD}^{commit}")
repo=$(basename "$root")
id=${head:0:12}
key=$(printf %s "$root" | shasum | cut -c1-8)
state="${REVIEW_BOT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/review-bot}"
mkdir -p "$state/logs" "$state/locks" "$state/worktrees" "$state/reports"

lock="$state/locks/$key-$id"
mkdir "$lock" 2>/dev/null || exit 0           # this HEAD is already being reviewed
log="$state/logs/$repo-$id.log"
report="$state/reports/$repo-$id.md"
wt="$state/worktrees/$key-$id"
branch="review/$id"
exec >>"$log" 2>&1
echo "== $(date -u +%FT%TZ) review-bot $repo ${base:0:12}..$id"

notify() {
  if [ -n "${REVIEW_BOT_NOTIFY_LOG:-}" ]; then
    printf '%s: %s\n' "$1" "$2" >>"$REVIEW_BOT_NOTIFY_LOG"
  else
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' "$1" "$2" >/dev/null 2>&1 || true
  fi
}

finish() {
  local code=$?
  [ -d "$wt" ] && git -C "$root" worktree remove --force "$wt" || true
  rmdir "$lock" 2>/dev/null || true
  if [ "$code" != 0 ]; then
    echo "review-bot failed (exit $code)"
    notify "Review failed in $repo" "Log: $log"
  fi
}
trap finish EXIT

git -C "$root" worktree add -q --detach "$wt" "$head"
git -C "$wt" reset -q --soft "$base"          # the change is now the uncommitted diff

allowed=(Skill Agent Read Grep Glob "Edit(/${wt}/**)" "Write(/${wt}/**)"
         "Bash(git status*)" "Bash(git diff*)" "Bash(git log*)" "Bash(git show*)"
         "Bash(git blame*)")
test_cmd=$(git -C "$root" config --get review.testCommand || true)
[ -n "$test_cmd" ] && allowed+=("Bash($test_cmd)" "Bash($test_cmd *)")
denied=("Bash(git push*)" "Bash(git commit*)" "Bash(git reset*)" "Bash(git checkout*)"
        "Bash(git switch*)" "Bash(git stash*)" "Bash(rm -rf*)" "Bash(curl*)" "Bash(wget*)")

(cd "$wt" && "${REVIEW_BOT_CLAUDE:-claude}" \
   -p "/code-review ${REVIEW_BOT_LEVEL:-medium} --fix" \
   --model "${REVIEW_BOT_MODEL:-sonnet}" \
   --max-budget-usd "${REVIEW_BOT_BUDGET:-2}" \
   --permission-mode dontAsk \
   --disallowedTools "${denied[@]}" \
   --allowedTools "${allowed[@]}") >"$report"

# Whatever the reviewer changed, as one commit on top of HEAD.
git -C "$wt" add -A
tree=$(git -C "$wt" write-tree)
if [ "$tree" = "$(git -C "$root" rev-parse "$head^{tree}")" ]; then
  notify "Review done in $repo" "No fixes. Report: $report"
  echo "done: no fixes"
  exit 0
fi
# The fix commit skips the pre-commit hook, so scan it here.
if command -v betterleaks >/dev/null 2>&1 \
   && ! (cd "$wt" && betterleaks git --pre-commit --staged --redact --no-banner --log-level warn); then
  notify "Review in $repo: fixes not kept" "betterleaks found a secret in them. Log: $log"
  exit 0
fi
msg=$(printf 'review: fixes from /code-review of %s..%s\n\n%s\n' "${base:0:12}" "$id" "$(cat "$report")")
fix=$(git -C "$root" commit-tree "$tree" -p "$head" -F - <<<"$msg")
git -C "$root" branch -f "$branch" "$fix"
notify "Review done in $repo" "Fixes on $branch. Report: $report"
echo "done: fixes on $branch"
